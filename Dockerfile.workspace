# Base atualizada para PHP 8.5 CLI
FROM php:8.5-cli

# Instala dependências do sistema, Git, Python e libs para compilar extensões PHP
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    ffmpeg \
    curl \
    python3 \
    python3-pip \
    python3-venv \
    libpq-dev \
    libzip-dev \
    libicu-dev \
    libonig-dev \
    && rm -rf /var/lib/apt/lists/*

# Extensões PHP essenciais (Laravel + PostgreSQL + multi-tenant)
RUN docker-php-ext-install \
    pdo_pgsql \
    pdo_mysql \
    pgsql \
    mysqli \
    bcmath \
    zip \
    intl \
    pcntl \
    sockets

# Redis via PECL (cache/queues do Laravel)
RUN pecl install redis \
    && docker-php-ext-enable redis

# Instala o Node.js 22 (Essencial para Vue 3, Nuxt 4 e CLIs baseados em Node)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs

# Instala o Composer (Para o Laravel)
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Instala o OpenCode CLI globalmente
RUN npm install -g opencode-ai

# Define o diretório de trabalho padrão
WORKDIR /app

# Mantém o container rodando indefinidamente aguardando ordens
CMD ["tail", "-f", "/dev/null"]
